# Keep real values in .env or .streamlit/secrets.toml. Never commit provider keys.

# HeyGen v3 — authorized avatar talking shots
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
HEYGEN_ENGINE=avatar_v

# Runway API — reference-controlled lifestyle and B-roll shots
RUNWAYML_API_SECRET=
RUNWAY_MODEL=gen4_turbo

# ElevenLabs — licensed synthetic voice or documented consent only
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# S3-compatible object storage — signed HTTPS provider inputs
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_PREFIX=creator-studio

# Trend Radar
YOUTUBE_DATA_API_KEY=
JUSTONEAPI_TOKEN=

# Cross-platform account connection, publishing, scheduling and analytics
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=sofia
