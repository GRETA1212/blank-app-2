    "x": 340,
    "y": 120,
    "wires": [["render-validate"]]
  },
  {
    "id": "render-validate",
    "type": "function",
    "z": "studio-flow",
    "name": "Validate project",
    "func": "const id = msg.payload && msg.payload.project_id;\nif (!id || typeof id !== 'string') {\n  msg.statusCode = 400;\n  msg.payload = { detail: 'project_id is required' };\n  return [null, msg];\n}\nmsg.method = 'POST';\nmsg.url = 'http://orchestrator:8000/production/jobs/' + encodeURIComponent(id);\nmsg.headers = { 'content-type': 'application/json' };\nmsg.payload = {};\nreturn [msg, null];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 550,
    "y": 120,
    "wires": [["render-call"], ["render-response"]]
  },
  {
    "id": "render-call",
    "type": "http request",
    "z": "studio-flow",
    "name": "Render approved project",
